{
  "info": {
    "_postman_id": "d53ec8ff-64c9-4de5-aac6-9ff5d8f90f1f",
    "name": "ParkX Backend",
    "description": "ParkX API collection aligned with final backend behavior (auth, vehicles, slots, bookings).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"charan\",\n  \"email\": \"charan@example.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const response = pm.response.json();",
              "  pm.collectionVariables.set(\"token\", response.data.token);",
              "  pm.collectionVariables.set(\"userId\", response.data.userId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"charan@example.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Vehicles - Add",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "  const response = pm.response.json();",
              "  pm.collectionVariables.set(\"vehicleId\", response.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicle_number\": \"AP09XY5678\",\n  \"vehicle_type\": \"car\",\n  \"model\": \"Tesla Model 3\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/vehicles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "vehicles"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Vehicles - Get User Vehicles",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const vehicles = pm.response.json();",
              "if (Array.isArray(vehicles) && vehicles.length > 0) {",
              "  pm.collectionVariables.set(\"vehicleId\", vehicles[0].id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/vehicles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "vehicles"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Slots - Get All Areas",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const areas = pm.response.json();",
              "if (Array.isArray(areas) && areas.length > 0) {",
              "  const firstArea = areas[0].area || areas[0].id || \"a\";",
              "  pm.collectionVariables.set(\"areaId\", firstArea);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/slots/areas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "slots",
            "areas"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Slots - Get Slots By Area",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const slots = pm.response.json();",
              "if (Array.isArray(slots) && slots.length > 0) {",
              "  const availableSlot = slots.find((slot) => !slot.is_occupied) || slots[0];",
              "  pm.collectionVariables.set(\"slotId\", availableSlot.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/slots/area/{{areaId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "slots",
            "area",
            "{{areaId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Bookings - Book a Slot",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const booking = pm.response.json();",
              "  pm.collectionVariables.set(\"bookingId\", booking.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicle_id\": {{vehicleId}},\n  \"slot_id\": {{slotId}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Bookings - Get Active Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const booking = pm.response.json();",
              "if (booking && booking.id) {",
              "  pm.collectionVariables.set(\"bookingId\", booking.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/bookings/active",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings",
            "active"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Bookings - Exit Parking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const booking = pm.response.json();",
              "  if (booking && booking.id) pm.collectionVariables.set(\"bookingId\", booking.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"booking_id\": \"{{bookingId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/bookings/exit",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings",
            "exit"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Vehicles - Delete Vehicle (Expected 400 if booking history exists)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/vehicles/{{vehicleId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "vehicles",
            "{{vehicleId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Bookings - Get Booking By ID (Receipt)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings",
            "{{bookingId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Bookings - Get Booking History",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/bookings/history",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings",
            "history"
          ]
        }
      },
      "response": []
    }
  ],
