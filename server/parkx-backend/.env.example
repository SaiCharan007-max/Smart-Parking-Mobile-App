DATABASE_URL=postgresql://username:password@host/database?sslmode=require&channel_binding=require
DB_SSL=true
DB_CHANNEL_BINDING=true

# Local fallback configuration (only used when DATABASE_URL is not set)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=parkx
DB_PASSWORD=postgres
DB_PORT=5432

PORT=5000

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=4h

# Environment
NODE_ENV=development

DEFAULT_RATE_PER_HOUR=45
